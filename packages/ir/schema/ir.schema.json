{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/javapak/arbor/schema/ir/0.1.0",
  "title": "arbor IR",
  "description": "The hub format. Mirrors packages/ir/src/types.ts; keep them in sync.",
  "type": "object",
  "required": ["irVersion", "profiles", "models"],
  "additionalProperties": false,
  "properties": {
    "irVersion": { "type": "string" },
    "profiles": { "type": "array", "items": { "$ref": "#/$defs/profile" } },
    "models": { "type": "array", "items": { "$ref": "#/$defs/model" } }
  },
  "$defs": {
    "scalar": { "type": ["string", "number", "boolean"] },
    "multiplicity": {
      "type": "object",
      "required": ["lower", "upper"],
      "additionalProperties": false,
      "properties": {
        "lower": { "type": "integer", "minimum": 0 },
        "upper": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "profile": {
      "type": "object",
      "required": ["name", "kinds", "enums", "datatypes", "stereotypes"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "kinds": { "type": "array", "items": { "$ref": "#/$defs/kind" } },
        "enums": { "type": "array", "items": { "$ref": "#/$defs/enum" } },
        "datatypes": { "type": "array", "items": { "$ref": "#/$defs/datatype" } },
        "stereotypes": { "type": "array", "items": { "$ref": "#/$defs/stereotype" } }
      }
    },
    "stereotype": {
      "type": "object",
      "required": ["id", "name", "extends", "features", "visual"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "extends": { "type": "array", "items": { "type": "string" } },
        "features": { "type": "array", "items": { "$ref": "#/$defs/feature" } },
        "visual": { "type": "object", "additionalProperties": { "$ref": "#/$defs/scalar" } }
      }
    },
    "datatype": {
      "type": "object",
      "required": ["id", "name", "features"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "features": { "type": "array", "items": { "$ref": "#/$defs/feature" } }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/value" }
    },
    "value": {
      "oneOf": [
        { "$ref": "#/$defs/scalar" },
        { "$ref": "#/$defs/record" },
        { "type": "array", "items": { "oneOf": [{ "$ref": "#/$defs/scalar" }, { "$ref": "#/$defs/record" }] } }
      ]
    },
    "enum": {
      "type": "object",
      "required": ["id", "name", "literals"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "literals": { "type": "array", "items": { "type": "string" } }
      }
    },
    "kind": {
      "type": "object",
      "required": ["id", "name", "abstract", "extends", "features", "visual"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "abstract": { "type": "boolean" },
        "extends": { "type": "array", "items": { "type": "string" } },
        "features": { "type": "array", "items": { "$ref": "#/$defs/feature" } },
        "visual": { "type": "object", "additionalProperties": { "$ref": "#/$defs/scalar" } },
        "visualWhen": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["feature", "value", "visual"],
            "additionalProperties": false,
            "properties": {
              "feature": { "type": "string" },
              "value": { "$ref": "#/$defs/scalar" },
              "visual": { "type": "object", "additionalProperties": { "$ref": "#/$defs/scalar" } }
            }
          }
        }
      }
    },
    "feature": {
      "oneOf": [
        {
          "type": "object",
          "required": ["feature", "name", "type", "multiplicity"],
          "additionalProperties": false,
          "properties": {
            "feature": { "const": "property" },
            "name": { "type": "string" },
            "type": {
              "oneOf": [
                { "enum": ["string", "int", "float", "bool"] },
                {
                  "type": "object",
                  "required": ["enum"],
                  "additionalProperties": false,
                  "properties": { "enum": { "type": "string" } }
                },
                {
                  "type": "object",
                  "required": ["datatype"],
                  "additionalProperties": false,
                  "properties": { "datatype": { "type": "string" } }
                }
              ]
            },
            "multiplicity": { "$ref": "#/$defs/multiplicity" },
            "default": { "$ref": "#/$defs/scalar" },
            "ordered": { "const": true },
            "unique": { "const": true },
            "readonly": { "const": true },
            "derived": { "const": true },
            "subsets": { "type": "array", "items": { "type": "string" } },
            "redefines": { "type": "array", "items": { "type": "string" } }
          }
        },
        {
          "type": "object",
          "required": ["feature", "name", "target", "multiplicity"],
          "additionalProperties": false,
          "properties": {
            "feature": { "enum": ["contains", "ref"] },
            "name": { "type": "string" },
            "target": { "type": "string" },
            "multiplicity": { "$ref": "#/$defs/multiplicity" },
            "visual": { "type": "object", "additionalProperties": { "$ref": "#/$defs/scalar" } },
            "opposite": { "type": "string" },
            "ordered": { "const": true },
            "unique": { "const": true },
            "readonly": { "const": true },
            "derived": { "const": true },
            "subsets": { "type": "array", "items": { "type": "string" } },
            "redefines": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "model": {
      "type": "object",
      "required": ["name", "elements"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "elements": { "type": "array", "items": { "$ref": "#/$defs/element" } }
      }
    },
    "element": {
      "type": "object",
      "required": ["id", "name", "kind", "parent", "containedIn", "children", "properties", "references"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "type": "string" },
        "parent": { "type": ["string", "null"] },
        "containedIn": { "type": ["string", "null"] },
        "stereotypes": { "type": "array", "items": { "type": "string" } },
        "children": { "type": "array", "items": { "type": "string" } },
        "properties": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/value" }
        },
        "references": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
