{
  "name": "arbor",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/ir",
    "packages/language",
    "packages/adapter-flow",
    "apps/studio"
  ],
  "scripts": {
    "setup": "npm i && cd packages/adapter-flow && npm i && cd ../ir && npm i && cd ../language && npm i && npm audit fix",
    "generate": "npm run generate -w @arbor/language",
    "build": "npm run generate && tsc -b packages/ir packages/adapter-flow packages/language && cd apps/studio && npm run build",
    "test": "npm run build && vitest run",
    "lint": "eslint .",
    "ir": "node --disallow-code-generation-from-strings packages/language/out/cli/main.js ir",
    "flow": "node --disallow-code-generation-from-strings packages/language/out/cli/main.js flow",
    "check": "node --disallow-code-generation-from-strings packages/language/out/cli/main.js check",
    "studio": "npm run build && npm run dev -w @arbor/studio"
  },
  "devDependencies": {
    "@cfworker/json-schema": "^4.1.6",
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.0.0",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true,
    "@swc/core@1.16.22": true
  }
}
