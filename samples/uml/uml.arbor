// A small slice of UML: class diagrams (classes with attribute and operation
// rows, and generalizations, realizations, dependencies and associations drawn
// as edges, each in its UML notation) and state machines owned by classes.

profile uml version "0.1.0" {

    abstract kind NamedElement {
        prop description: string [0..1]
    }

    abstract kind PackageableElement extends NamedElement {}

    kind Package extends PackageableElement {
        contains members: PackageableElement [0..*]
        visual { shape: "package" color: "#facc15" container: true }
    }

    // As in UML: attributes and operations are both members (a derived union),
    // kept in order, and each knows its classifier (a derived opposite).
    abstract kind Classifier extends PackageableElement {
        prop             isAbstract:      bool = false
        derived contains ownedMembers:    NamedElement [0..*]
        ordered contains attributes:      Property [0..*] subsets ownedMembers
        ordered contains operations:      Operation [0..*] subsets ownedMembers
        contains         generalizations: Generalization [0..*]
        contains         realizations:    InterfaceRealization [0..*]
    }

    // A class can nest classifiers and own behaviors. A behavior is itself a class,
    // so a state machine fits both: say which with `ownedBehavior += StateMachine ...`.
    kind Class extends Classifier {
        contains nestedClassifier:   Classifier [0..*] subsets ownedMembers
        contains ownedBehavior:      Behavior [0..*] subsets ownedMembers
        ref      classifierBehavior: Behavior [0..1] { hidden: true }
        visual { shape: "rectangle" color: "#0ea5e9" }
    }

    kind Interface extends Classifier {
        visual { shape: "rectangle" color: "#22c55e" label: "«interface» {name}" }
    }

    kind DataType extends Classifier {
        visual { shape: "rectangle" color: "#94a3b8" label: "«dataType» {name}" }
    }

    // Rows in their classifier's box, like UML compartments.
    kind Property extends NamedElement {
        derived ref classifier: Classifier [0..1] opposite attributes
        ref  type:         Classifier [0..1]
        prop multiplicity: string [0..1]
        visual { member: true  label: "{name}{? : {type}}{? [{multiplicity}]}" }
    }

    kind Operation extends NamedElement {
        derived ref classifier: Classifier [0..1] opposite operations
        ref returns: Classifier [0..1]
        visual { member: true  label: "{name}(){? : {returns}}" }
    }

    // Relationships: elements drawn as edges. Owned by the specific classifier.
    kind Generalization {
        ref general: Classifier [1]
        visual { source: "owner" target: "general" targetMarker: "triangle" label: "" }
    }

    kind InterfaceRealization {
        ref contract: Interface [1]
        visual { source: "owner" target: "contract" targetMarker: "triangle" line: "dashed" label: "" }
    }

    kind Dependency extends PackageableElement {
        ref client:   NamedElement [1]
        ref supplier: NamedElement [1]
        visual { source: "client" target: "supplier" targetMarker: "arrow" line: "dashed" label: "«use»" }
    }

    kind Association extends PackageableElement {
        ref  from:             Classifier [1]
        ref  to:               Classifier [1]
        prop fromRole:         string [0..1]
        prop fromMultiplicity: string [0..1]
        prop toRole:           string [0..1]
        prop toMultiplicity:   string [0..1]
        visual {
            source: "from"  target: "to"  targetMarker: "arrow"
            label: "{name}"
            sourceLabel: "{fromRole} {fromMultiplicity}"
            targetLabel: "{toRole} {toMultiplicity}"
        }
    }

    // The whole owns its parts: a filled diamond at the whole's end.
    kind Composition extends Association {
        visual { sourceMarker: "filledDiamond" }
    }

    kind Aggregation extends Association {
        visual { sourceMarker: "diamond" }
    }

    // ------------------------------------------------------------ state machines

    abstract kind Behavior extends Class {}

    // State machines, regions and composite states are drawn as boxes holding
    // what they contain where it's dragged (a free layout), joined by transitions.
    kind StateMachine extends Behavior {
        contains regions: Region [1..*]
        visual { shape: "roundedRectangle" color: "#a855f7" container: true layout: "free" diagram: true label: "«stateMachine» {name}" }
    }

    kind Region extends NamedElement {
        contains subvertices: Vertex [0..*]
        contains transitions: Transition [0..*]
        visual { shape: "rectangle" color: "#e9d5ff" container: true layout: "free" width: 120 height: 60 }
    }

    // Each vertex knows its transitions: whoever names it as source or target.
    abstract kind Vertex extends NamedElement {
        derived ref outgoing: Transition [0..*] opposite source
        derived ref incoming: Transition [0..*] opposite target
    }

    kind State extends Vertex {
        prop entry:      string [0..1]
        prop exit:       string [0..1]
        prop doActivity: string [0..1]
        contains regions: Region [0..*]
        visual { shape: "roundedRectangle" color: "#c084fc" container: true layout: "free" width: 140 height: 50 }
    }

    kind FinalState extends State {
        visual { shape: "finalNode" color: "#1e293b" label: "" width: 30 height: 30 }
    }

    enum PseudostateKind { initial, choice, junction, fork, join, deepHistory, shallowHistory, entryPoint, exitPoint, terminate }

    // Drawn by its kind, in UML's notation: an initial dot, a choice diamond, a fork or join bar, H for history...
    kind Pseudostate extends Vertex {
        prop kind: PseudostateKind = initial
        visual { shape: "initialNode" color: "#1e293b" label: "" width: 24 height: 24 }
        visual when kind = choice         { shape: "diamond"  color: "rgb(134, 255, 249)" width: 32 height: 32 }
        visual when kind = junction       { width: 14 height: 14 }
        visual when kind = fork           { shape: "rectangle" width: 80 height: 8 }
        visual when kind = join           { shape: "rectangle" width: 80 height: 8 }
        visual when kind = shallowHistory { shape: "circle" color: "#f8fafc" labelColor: "#1e293b" label: "H"  width: 28 height: 28 }
        visual when kind = deepHistory    { shape: "circle" color: "#f8fafc" labelColor: "#1e293b" label: "H*" width: 28 height: 28 }
        visual when kind = entryPoint     { shape: "circle" color: "#f8fafc" width: 18 height: 18 }
        visual when kind = exitPoint      { shape: "circle" color: "#f8fafc" labelColor: "#1e293b" label: "×" width: 18 height: 18 }
        visual when kind = terminate      { shape: "none" labelColor: "#1e293b" label: "×" width: 24 height: 24 }
    }

    kind Transition extends NamedElement {
        ref  source:  Vertex [1]
        ref  target:  Vertex [1]
        prop trigger: string [0..1]
        prop guard:   string [0..1]
        prop effect:  string [0..1]
        visual { source: "source" target: "target" targetMarker: "arrow" label: "{trigger}{? [{guard}]}{? / {effect}}" }
    }
}
