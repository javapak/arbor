// A lending library as a UML class diagram (see uml.arbor), with members
// mapped to a table through the orm profile's stereotypes.
model library {

    DataType String {}
    DataType Date {}

    Class Item {
        isAbstract: true
        Property title { type: -> String }
        Operation checkOut { returns: -> Date }
        InterfaceRealization { contract: -> Lendable }
    }

    Class Book {
        Property isbn { type: -> String }
        Generalization { general: -> Item }
    }

    Class Disc {
        Property minutes { type: -> String }
        Generalization { general: -> Item }
    }

    Interface Lendable {
        Operation lend { returns: -> Date }
    }

    Class Library {
        Property name { type: -> String }
    }

    <<Entity>> Class Member {
        table: "members"
        indexes: [ { columns: ["name"] }, { columns: ["name", "since"]  unique: true } ]
        <<Id>> Property number { type: -> String }
        Property name { type: -> String }
        Property since { type: -> Date }
    }

    Composition holdings {
        from: -> Library  to: -> Item
        toRole: "items"  toMultiplicity: "0..*"
    }

    Association loans {
        from: -> Member  to: -> Item
        fromRole: "borrower"  fromMultiplicity: "0..1"
        toRole: "loans"  toMultiplicity: "0..*"
    }

    Dependency borrows {
        client: -> Member  supplier: -> Lendable
    }
}
